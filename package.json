{
  "name": "mars-console",
  "version": "0.1.0",
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8",
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.2.5",
    "geotiff": "2.1.3",
    "typescript": "5.7.3"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tiles": "bun scripts/fetch-tiles.js",
    "test": "bun test",
    "typecheck": "bun run --filter @nimbs/shared typecheck && bun run --filter @nimbs/api typecheck && bun run --filter @nimbs/web typecheck",
    "lint": "biome check apps packages scripts/data scripts/assets scripts/dev.ts",
    "fetch-site": "bun run scripts/data/fetch-site.ts",
    "dev:planner": "bun run scripts/dev.ts",
    "build:planner": "bun run --filter @nimbs/web build"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
