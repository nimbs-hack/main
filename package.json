{
  "name": "mars-mission-planner",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run --filter @nimbs/web build",
    "test": "bun test",
    "typecheck": "bun run --filter @nimbs/shared typecheck && bun run --filter @nimbs/api typecheck && bun run --filter @nimbs/web typecheck",
    "lint": "biome check apps packages scripts",
    "fetch-site": "bun run scripts/data/fetch-site.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.2.5",
    "geotiff": "2.1.3",
    "typescript": "5.7.3"
  }
}
